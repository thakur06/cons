# Server Configuration
PORT=5000
JWT_SECRET=super_secret_jwt_key_s3_postgres_2026

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=s3_file_manager_db

# Or full database connection URL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/s3_file_manager_db

# AWS S3 Configuration
# If AWS credentials are left blank or omitted, the application will use built-in local file storage fallback!
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=my-pdf-docx-bucket
